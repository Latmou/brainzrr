// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Recording {
  mbid      String   @id
  title     String
  artist    String
  releaseId String?
  duration  Int? // milliseconds
  data      Json // Store full MB response
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Release {
  mbid        String   @id
  title       String
  artist      String
  coverArtUrl String?
  data        Json // Store full MB response
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
